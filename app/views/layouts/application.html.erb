<!DOCTYPE html>
<html>
  <head>
    <title>Earmark</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <a class="brand" href="/">Earmark</a>
      <span class="sub">designated giving ledger</span>
    </header>
    <% if flash[:notice] %><p class="flash ok"><%= flash[:notice] %></p><% end %>
    <% if flash[:alert] %><p class="flash bad"><%= flash[:alert] %></p><% end %>
    <main><%= yield %></main>
    <footer>
      Rails <%= Rails.version %> on PostgreSQL. Allocations are append-only; fund balances
      are derived from the ledger, never stored.
      <a href="https://github.com/tachyurgy/earmark">Source</a>
    </footer>
  </body>
</html>
